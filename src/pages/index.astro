---
/* src/pages/index.astro */
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/navbar.astro";
import ContactForm from "../components/ContactForm.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import type { ImageMetadata } from "astro";

import profileImg from "../images/me-architect.jpg";
const profileImageMetaData = profileImg as unknown as ImageMetadata;
---

<BaseLayout 
  title="JoySomatic | Systems of the Heart, Sound & Code"
  description="Expert somatic coaching, tech mentorship, and music production by José Oñate Yáñez[cite: 12]. Bridging analytical systems with emotional and acoustic well-being."
>
  <Navbar />
  <div class="pt-20 md:pt-24 px-6">
    <div class="mx-auto max-w-4xl">
      <header class="relative text-left py-16 md:py-20">
        <div class="absolute inset-0 bg-white/65 backdrop-blur-2xl border-b border-violet-100/50"></div>
        <div class="relative max-w-4xl mx-auto px-6">
          <p class="text-[0.7rem] uppercase tracking-[0.35em] text-indigo-700/90 mb-4">
            Systems of the Heart, Sound & Code
          </p>
          <h1 class="text-[2.4rem] md:text-[3.1rem] leading-tight font-semibold text-indigo-950/90 drop-shadow-sm">
            JoySomatic
          </h1>
          <p class="mt-4 text-base md:text-lg text-indigo-900/85 max-w-none">
            Decoding the language of the Body, Relationships, and Systems through somatics, sound, and engineering.
          </p>
        </div>
      </header>

      <main class="pb-16">
        <section id="about" class="mt-12 md:mt-16">
          <h2 class="inline-block text-2xl md:text-3xl font-semibold text-indigo-950/90 border-b border-pink-200 pb-1">
            Hi, I’m José.
          </h2>

          <div class="mt-8 text-base md:text-lg text-indigo-900/90 leading-relaxed">
            <div class="md:float-right md:ml-10 mb-8 w-full md:w-72 lg:w-80 aspect-square relative group">
              <div class="absolute -inset-1.5 bg-gradient-to-tr from-pink-200 to-violet-300 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700"></div>
              <div class="relative h-full w-full overflow-hidden rounded-2xl border border-white/40 shadow-xl">
                <OptimizedImage 
                  src={profileImageMetaData} 
                  alt="José Oñate" 
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                />
              </div>
            </div>

            <p class="mb-6">
              I look at life through two lenses: the somatic heart that feels the rhythm, and the engineer’s mind that understands the system. My journey has been a lifelong exploration of finding the signal in the noise, whether in a piece of code, a studio mix, or a human emotion.
            </p>

            <p class="mb-6">
              With a Bachelor’s Degree in Computer Science and a Bachelor’s Degree in Music, Composition & Sound, plus nearly two decades of sound engineering experience, I bring a technical yet deeply human approach to coaching across technology, music production, and nervous system regulation.
            </p>

            <div class="clear-both"></div>
          </div>
        </section>

        <!-- Coaching Offerings Grid -->
        <section class="mt-12 md:mt-16">
          <h2 class="inline-block text-2xl md:text-3xl font-semibold text-indigo-950/90 border-b border-pink-200 pb-1 mb-8">
            Coaching & Practice Pillars
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="/somatic" class="block group rounded-[2.25rem] bg-white/90 p-6 shadow-[0_18px_45px_rgba(148,163,184,0.5)] border border-pink-100 hover:-translate-y-1 transition duration-300">
              <span class="text-xs uppercase tracking-widest text-pink-600 font-bold">Pillar 01</span>
              <h3 class="text-xl font-semibold text-indigo-950/90 mt-2 group-hover:text-pink-600 transition">Somatic Coaching</h3>
              <p class="mt-3 text-sm text-indigo-900/80 leading-relaxed">
                Data-driven nervous system tools for high-intellect individuals. Learn the Sensation → Story → Choice algorithm to break fear & anxiety loops.
              </p>
              <span class="inline-block mt-4 text-xs font-bold text-pink-600 underline">Explore Somatic →</span>
            </a>

            <a href="/tech" class="block group rounded-[2.25rem] bg-white/90 p-6 shadow-[0_18px_45px_rgba(148,163,184,0.5)] border border-indigo-100 hover:-translate-y-1 transition duration-300">
              <span class="text-xs uppercase tracking-widest text-indigo-600 font-bold">Pillar 02</span>
              <h3 class="text-xl font-semibold text-indigo-950/90 mt-2 group-hover:text-indigo-600 transition">Tech Coaching</h3>
              <p class="mt-3 text-sm text-indigo-900/80 leading-relaxed">
                Patience-first guidance for everyday tech, devices, AI development, parental controls, and custom Google Workspace/Script automations.
              </p>
              <span class="inline-block mt-4 text-xs font-bold text-indigo-600 underline">Explore Tech →</span>
            </a>

            <a href="/audio" class="block group rounded-[2.25rem] bg-white/90 p-6 shadow-[0_18px_45px_rgba(148,163,184,0.5)] border border-emerald-100 hover:-translate-y-1 transition duration-300">
              <span class="text-xs uppercase tracking-widest text-emerald-600 font-bold">Pillar 03</span>
              <h3 class="text-xl font-semibold text-indigo-950/90 mt-2 group-hover:text-emerald-600 transition">Audio Coaching</h3>
              <p class="mt-3 text-sm text-indigo-900/80 leading-relaxed">
                20+ years of studio experience. Master self-production, mic placement, recording, mixing, and mastering for your music.
              </p>
              <span class="inline-block mt-4 text-xs font-bold text-emerald-600 underline">Explore Audio →</span>
            </a>
          </div>
        </section>

        <section id="contact" class="mt-16">
          <ContactForm subject="General Inquiry - JoySomatic Home" categoryTitle="General Coaching & Inquiries" />
        </section>
      </main>

      <footer class="mt-16 border-t border-violet-100/80 text-center text-xs md:text-sm text-indigo-900/70 py-6 px-4">
        <p>© 2026 JoySomatic – José Oñate Yáñez | Built with Code & Heart</p>
      </footer>
    </div>
  </div>
</BaseLayout>