---
/* src/pages/audio.astro */
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/navbar.astro";
import ContactForm from "../components/ContactForm.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import type { ImageMetadata } from "astro";

import labImg from "../images/bass-lab.jpg";
const labImageMetaData = labImg as unknown as ImageMetadata;
---

<BaseLayout 
  title="Music Production & Audio Coaching | JoySomatic"
  description="Master self-production, acoustic tracking, mixing, and high-resolution mastering with 20+ years of professional studio and audio engineering experience."
>
  <Navbar />
  <div class="pt-20 md:pt-24 px-6">
    <div class="mx-auto max-w-4xl">
      <header class="relative text-left py-12 md:py-16">
        <div class="absolute inset-0 bg-white/65 backdrop-blur-2xl border-b border-violet-100/50"></div>
        <div class="relative max-w-4xl mx-auto px-6">
          <p class="text-[0.7rem] uppercase tracking-[0.35em] text-indigo-700/90 mb-3">
            20+ Years of Acoustic & Production Mastery
          </p>
          <h1 class="text-[2.2rem] md:text-[2.8rem] leading-tight font-semibold text-indigo-950/90">
            Music Production & Sound Coaching
          </h1>
          <p class="mt-3 text-base md:text-lg text-indigo-900/85">
            Learn to self-produce, record, mix, and master your own musical vision with professional acoustic precision.
          </p>
        </div>
      </header>

      <main class="py-12 space-y-12">
        <section class="flex flex-col md:flex-row items-center gap-8">
          <div class="w-full md:w-1/2 relative group">
            <div class="absolute -inset-1 bg-gradient-to-tr from-emerald-200 to-sky-300 rounded-2xl blur opacity-30 group-hover:opacity-50 transition duration-700"></div>
            <div class="relative h-56 md:h-64 w-full overflow-hidden rounded-xl border border-white/40 shadow-lg">
              <OptimizedImage src={labImageMetaData} alt="The Bass Studio Lab" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="w-full md:w-1/2 space-y-4 text-indigo-900/90 text-base md:text-lg">
            <h2 class="text-2xl font-semibold text-indigo-950/90">Crafting Acoustic Resonance</h2>
            <p>
              Holding a Bachelor’s Degree in Music, Composition & Sound, and having worked in audio engineering since 2007, I help artists bridge the gap between creative impulse and release-ready production.
            </p>
          </div>
        </section>

        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-indigo-950/90 border-b border-pink-200 pb-2">
            Production & Engineering Topics
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Self-Production & Arranging</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Transform rough ideas into full song arrangements. Learn structure, instrument selection, and creative flow to complete projects efficiently.
              </p>
            </div>

            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Microphone Placement & Tracking</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Capture high-quality audio at home. Master microphone selection, acoustic isolation, vocal tracking, and room setup to achieve clean recordings.
              </p>
            </div>

            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Mixing & Dynamic Balance</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Understand phase alignment, equalization, dynamic compression, space/reverb, and spatial separation to give every instrument its place.
              </p>
            </div>

            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">High-Resolution Mastering</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Prepare final tracks for commercial streaming platforms. Learn limiting, loudness standards, tonal balance, and final export fidelity.
              </p>
            </div>
          </div>
        </section>

        <section id="contact-form" class="pt-6">
          <ContactForm subject="Inquiry: Audio Solutions & Music Production" categoryTitle="Music Production & Sound Coaching" />
        </section>
      </main>

      <footer class="mt-16 border-t border-violet-100/80 text-center text-xs md:text-sm text-indigo-900/70 py-6 px-4">
        <p>© 2026 JoySomatic – José Oñate Yáñez | Built with Code & Heart</p>
      </footer>
    </div>
  </div>
</BaseLayout>