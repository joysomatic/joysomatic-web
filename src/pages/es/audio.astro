---
/* src/pages/es/audio.astro */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navbar.astro";
import ContactForm from "../../components/ContactForm.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import type { ImageMetadata } from "astro";

import labImg from "../../images/bass-lab.webp";
const labImageMetaData = labImg as unknown as ImageMetadata;
---

<BaseLayout 
  title="Coaching de Producción Musical y Audio | JoySomatic"
  description="Domina la autoproducción, microfonía, grabación, mezcla y masterización con más de 20 años de experiencia profesional en estudio y audio[cite: 12]."
>
  <Navbar />
  <div class="pt-20 md:pt-24 px-6">
    <div class="mx-auto max-w-4xl">
      <header class="relative text-left py-12 md:py-16">
        <div class="absolute inset-0 bg-white/65 backdrop-blur-2xl border-b border-violet-100/50"></div>
        <div class="relative max-w-4xl mx-auto px-6">
          <p class="text-[0.7rem] uppercase tracking-[0.35em] text-indigo-700/90 mb-3">
            Más de 20 Años de Experiencia en Audio y Producción
          </p>
          <h1 class="text-[2.2rem] md:text-[2.8rem] leading-tight font-semibold text-indigo-950/90">
            Coaching de Producción Musical y Sonido
          </h1>
          <p class="mt-3 text-base md:text-lg text-indigo-900/85">
            Aprende a autoproducir, grabar, mezclar y masterizar tu propia música con precisión profesional.
          </p>
        </div>
      </header>

      <main class="py-12 space-y-12">
        <section class="flex flex-col md:flex-row items-center gap-8">
          <div class="w-full md:w-1/2 relative group">
            <div class="absolute -inset-1 bg-gradient-to-tr from-emerald-200 to-sky-300 rounded-2xl blur opacity-30 group-hover:opacity-50 transition duration-700"></div>
            <div class="relative h-56 md:h-64 w-full overflow-hidden rounded-xl border border-white/40 shadow-lg">
              <OptimizedImage src={labImageMetaData} alt="El Laboratorio de Estudio" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="w-full md:w-1/2 space-y-4 text-indigo-900/90 text-base md:text-lg">
            <h2 class="text-2xl font-semibold text-indigo-950/90">Creando Resonancia Acústica</h2>
            <p>
              Con una Licenciatura en Música, Composición y Sonido, y trabajando en ingeniería de audio desde 2007, ayudo a artistas y creadores a transformar ideas en producciones terminadas y listas para publicar.
            </p>
          </div>
        </section>

        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-indigo-950/90 border-b border-pink-200 pb-2">
            Áreas de Trabajo
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Autoproducción y Arreglos</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Transforma maquetas iniciales en canciones estructuradas. Aprende selección de instrumentos, dinámicas y flujo creativo para finalizar temas.
              </p>
            </div>

            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Técnicas de Microfonía y Grabación</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Captura sonido limpio desde tu espacio. Domina el uso de micrófonos, acústica básica y técnicas de grabación de voz e instrumentos.
              </p>
            </div>

            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Mezcla y Balance Dinámico</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Comprende la alineación de fase, ecualización, compresión y balance espacial para dar a cada elemento su lugar exacto en la mezcla.
              </p>
            </div>

            <div class="rounded-[2rem] bg-white/90 p-6 shadow-md border border-emerald-100">
              <h3 class="text-lg font-semibold text-indigo-950/90 mb-2">Masterización de Alta Resolución</h3>
              <p class="text-sm text-indigo-900/80 leading-relaxed">
                Prepara tus temas finales para plataformas de streaming con estándares de volumen, balance tonal y exportación profesional.
              </p>
            </div>
          </div>
        </section>

        <section id="contact-form" class="pt-6">
          <ContactForm subject="Consulta: Producción de Audio y Música" categoryTitle="Coaching de Producción Musical" isSpanish={true} />
        </section>
      </main>

      <footer class="mt-16 border-t border-violet-100/80 text-center text-xs md:text-sm text-indigo-900/70 py-6 px-4">
        <p>© 2026 JoySomatic – José Oñate Yáñez | Creado con Código y Corazón</p>
      </footer>
    </div>
  </div>
</BaseLayout>